# Environment
ENV="production"

# Discord Bot Credentials
DISCORD_TOKEN="discord_token"
CLIENT_ID="client_id"
GUILD_ID="guild_id"

# ======= CHANNEL ID ========
POLL_CHANNEL_ID="poll_channel_id"
SAFE_PLACE_CHANNEL_ID="safe_place_channel_id"
ROLE_CHANNEL_ID="role_channel_id"
THREAD_LIST_CHANNEL_ID="thread_list_channel_id"
CHANGELOG_CHANNEL_ID="changelog_channel_id"

# ======== MESSAGE ID ========
ROLE_MESSAGE_ID="role_message_id"
THREAD_LIST_MESSAGE_ID="thread_list_message_id"

# ======== ROLE ID ========
DEFAULT_ROLE_ID="default_role_id"
TEMPORY_MEMBER_ROLE_ID="tempory_member_role_id"
COLOR_ROLE_ID="color_role_id"
PING_ROLE_ID="ping_role_id"
DISCORD_BET_ROLE_ID="discord_bet_role_id"

# ======== USER ID ========
SYDNEC_USER_ID="sydnec_user_id"

# ======== INVITE CODE ========
TEMPORY_MEMBER_INVITE_CODE="tempory_member_invite_code"

# ======== COTD ========
COTD_CRON_TIMER="0 10 * * *"
COTD_CHANNEL_ID="cotd_channel_id"

# ======== POKEMON ========
# Salon dédié aux apparitions. Absent => le système de capture est désactivé.
POKEMON_CHANNEL_ID="pokemon_channel_id"
# Rôle optionnel mentionné sur les spawns rares, shiny et légendaires.
POKEMON_ROLE_ID="pokemon_role_id"

# ======== SITE ET API WEB ========
# Tout est facultatif : sans WEB_PORT, ni le site ni l'API ne démarrent.
# Voir docs/site.md pour la mise en ligne.
# Port d'écoute, derrière le reverse proxy.
WEB_PORT=""
# Adresse d'écoute : 127.0.0.1 par défaut. Mettre l'IP locale de la machine si
# le reverse proxy est sur une autre, et n'ouvrir le port qu'à lui.
WEB_HOST=""
# Adresse publique du site, sans barre finale. La connexion Discord y revient :
# ${WEB_BASE_URL}/api/auth/callback est à déclarer dans les « Redirects » OAuth2
# de l'application Discord.
WEB_BASE_URL="https://pokepcr.simonbourlier.fr"
# Secret de l'application Discord (onglet OAuth2), avec CLIENT_ID ci-dessus.
DISCORD_CLIENT_SECRET="discord_client_secret"
# Au moins 32 caractères aléatoires : il signe les sessions. Le changer
# déconnecte tout le monde.
WEB_SESSION_SECRET="changer_moi_par_32_caracteres_aleatoires_au_moins"

##############
# TEMPORAIRE #
##############

# ======== AVENT ========
ADVENT_CRON_TIMER="0 0 1-24 12 *"
ADVENT_CHANNEL_ID="advent_channel_id"
