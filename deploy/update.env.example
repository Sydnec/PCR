# /etc/pcr/update.env — réglages de pcr-update (root, 0600).
# Branche suivie : "dev" (bot de dev) ou "prod" (suit main).
PCR_CHANNEL=dev
PCR_REPO=Sydnec/PCR
# Adresse de santé du bot (instance.toml → [web] listen).
PCR_HEALTH_URL=http://127.0.0.1:8080/healthz
# Webhook Discord d'un salon ops : déploiements et retours arrière. Vide = pas d'alerte.
PCR_OPS_WEBHOOK=
