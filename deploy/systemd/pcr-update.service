# Installe la dernière version signée de la branche suivie (voir /etc/pcr/update.env).
[Unit]
Description=PCR self-update from signed GitHub releases
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/pcr/update.env
# cosign garde sa racine de confiance Sigstore (TUF) en cache : un service root sans User= n'a pas de
# HOME, on lui donne donc un dossier explicite.
StateDirectory=pcr-update
Environment=HOME=/root TUF_ROOT=/var/lib/pcr-update/tuf
ExecStart=/usr/local/sbin/pcr-update
