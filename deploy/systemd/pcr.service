# Le bot et le site. Le binaire actif est /opt/pcr/current/pcr, basculé par pcr-update.
[Unit]
Description=PCR Discord bot and website
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pcr
Group=pcr
EnvironmentFile=/etc/pcr/pcr.env
Environment=PCR_INSTANCE=/etc/pcr/instance.toml
Environment=RUST_LOG=info
ExecStart=/opt/pcr/current/pcr serve
# `/admin restart` sort proprement : systemd relance.
Restart=always
RestartSec=5
# Laisse le temps de vider les tampons de stats et de fermer la gateway.
TimeoutStopSec=30
StateDirectory=pcr
StateDirectoryMode=0750
ReadWritePaths=/var/backups/pcr
UMask=0027

# Durcissement : le bot n'a besoin que du réseau et de son dossier de données.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
